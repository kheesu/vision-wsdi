# Python
__pycache__/
*.py[oc]
*.egg-info/

# Environment
.venv/
environment.lock.txt

# Generated artifacts (regenerated by the pipeline)
cache/*.pt
data/*.parquet
data/*.csv
results/*

# Keep directory placeholders
!data/.gitkeep
!cache/.gitkeep
!results/.gitkeep

# Box audit is machine-specific
box_audit.txt
box_audit.json

# Local tooling
.claude/
.pytest_cache/
.ruff_cache/

# Generated figures (regenerate with `make figures`; requires ImageNet-21k locally)
/figures/
